# SwitchRecomp PS5 / build-machine network settings.
# Shared defaults (LAN addresses only, no secrets) -- committed so the 253 build
# box gets them via `git reset --hard origin/ps5`.
# Override locally without touching git: edit .env.local (git-ignored), or set
# the equivalent environment variable before running a tool.

# ---- PS5 console ----
PS5_HOST=192.168.88.33
PS5_FTP_PORT=2121
PS5_WFM_PORT=8888
PS5_TITLE_ID=PPSA99201

# ---- 253 build / deploy machine ----
DEV_HOST=192.168.88.253
DEV_USER=swizard
DEV_CODE_DIR=/data/code/switchrecomp
DEV_WORK_ROOT=/data/switchrecomp
